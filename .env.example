# Leave DRUPAL_BASE_URL unset to run against the committed fixture snapshot.
# With it set, the app talks to a live Drupal site over JSON:API.
NUXT_DRUPAL_BASE_URL=

# Optional bearer token for authenticated JSON:API reads.
NUXT_DRUPAL_TOKEN=

# Shared secret used to sign preview links. Required only for preview mode.
NUXT_DRUPAL_PREVIEW_SECRET=

# Shared secret Drupal signs cache-invalidation webhooks with.
NUXT_DRUPAL_REVALIDATE_SECRET=

# Canonical public origin, used for SEO tags and the sitemap.
NUXT_PUBLIC_SITE_URL=http://localhost:3000
